# PHASE 03 - copy to .env; never commit a populated .env file.
# Generate a password hash: node scripts/hash-password.mjs
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
MCP_HOST=127.0.0.1
MCP_PORT=3000
# Optional public HTTPS origin for TLS/proxy/tunnel. Must contain scheme and host only.
# MCP_PUBLIC_URL=https://mcp.example.com
# When binding 0.0.0.0 configure real TLS cert/key paths:
# MCP_TLS_CERT_FILE=/path/to/fullchain.pem
# MCP_TLS_KEY_FILE=/path/to/privkey.pem
# Enter the EXACT redirect URI from the ChatGPT custom MCP connection screen.
OAUTH_ALLOWED_REDIRECT_URIS=
MCP_ALLOWED_TOOLS=system_status,disk_usage
MCP_AUDIT_FILE=./data/audit.jsonl
MCP_STATE_FILE=./data/oauth-state.json
MCP_LOG_LEVEL=info
